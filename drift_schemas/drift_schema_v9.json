    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"series_id\" INTEGER NULL, \"date\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"tone_index\" INTEGER NOT NULL, \"start_minute\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL, \"status\" INTEGER NOT NULL DEFAULT 0, \"is_flight\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_flight\" IN (0, 1)), \"flight_number\" TEXT NULL, \"from_code\" TEXT NULL, \"to_code\" TEXT NULL, \"project_id\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "event_series",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"event_series\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"tone_index\" INTEGER NOT NULL, \"start_minute\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL, \"recurrence_kind\" INTEGER NOT NULL, \"weekday_mask\" INTEGER NOT NULL DEFAULT 0, \"valid_from\" INTEGER NOT NULL, \"valid_until\" INTEGER NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"event_id\" INTEGER NOT NULL REFERENCES events (id), \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"planned_seconds\" INTEGER NOT NULL, \"paused_seconds\" INTEGER NOT NULL DEFAULT 0, \"pause_started_at\" INTEGER NULL, \"active_seconds\" INTEGER NOT NULL DEFAULT 0, \"overtime_seconds\" INTEGER NOT NULL DEFAULT 0, \"outcome\" INTEGER NOT NULL DEFAULT 0, \"energy_rating\" INTEGER NULL, \"focus_rating\" INTEGER NULL, \"tags_csv\" TEXT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
