          "sql": "CREATE TABLE IF NOT EXISTS \"day_templates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
